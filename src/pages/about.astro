---
import Layout from '../layouts/Layout.astro';
import directus, { readItems } from '../lib/directus.ts';

const team = await directus.request(
  readItems('team_member', {
    filter: { active: { _eq: true } },
    fields: ['full_name', 'job_title', 'bio', 'photo', 'linkedin'],
  })
);
---

<Layout title="About Us - City Layers">
<style>
    .team-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }
    .team-member {
        text-align: center;transition: transform 0.2s ease;
    cursor: pointer;
    }
    .team-member:hover {
    transform: translateY(-4px);
    }
    .member-photo {
        width: 150px;
        height: 150px;
        margin: 0 auto 1rem;
        border-radius: 50%;
        overflow: hidden;
    }
    .member-name {
        font-size: 1rem;
    }
    .member-role {
        font-size: 0.85rem;
    }
    .member-bio {
        font-size: 0.85rem;
    }
    @media (max-width: 900px) {
        .team-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 480px) {
        .team-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">About City Layers</h1>
            <p class="page-subtitle">We believe that everyone should have a voice in shaping the cities where they live, work, and play.</p>
        </div>
    </section>

    <section class="our-story">
        <div class="container">
            <div class="story-content">
                <div class="story-text">
                    <h2 class="section-title">Our Story</h2>
                    <p>City Layers was born from a simple observation: urban planning processes often exclude the very people they're meant to serve. Traditional public consultations are time-consuming, inaccessible, and fail to capture the diversity of community perspectives.</p>
                    <p>We set out to change that. By combining innovative technology with inclusive design principles, we've created a platform that makes urban participation accessible, engaging, and impactful for everyone.</p>
                    <p>Today, City Layers empowers communities and planners across Europe to collaborate on creating better, more livable urban spaces. From neighborhood improvements to city-wide strategic planning, we're helping to build the participatory cities of tomorrow.</p>
                </div>
                <div class="story-image">
                    <div class="image-placeholder">
                        <div class="placeholder-text">Your team photo or<br>office environment</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="values-section">
        <div class="container">
            <h2 class="section-title text-center">Our Values</h2>
            <div class="values-grid">
                <div class="value-card">
                    <div class="value-icon">🌍</div>
                    <h3>Inclusive by Design</h3>
                    <p>We build tools that work for everyone, regardless of technical expertise, language, or accessibility needs.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">🤝</div>
                    <h3>Community First</h3>
                    <p>Local knowledge and lived experience are at the heart of effective urban planning.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">💡</div>
                    <h3>Innovation & Impact</h3>
                    <p>We leverage technology not for its own sake, but to create real, measurable improvements in people's lives.</p>
                </div>
                <div class="value-card">
                    <div class="value-icon">🔓</div>
                    <h3>Transparency</h3>
                    <p>Open processes and clear communication build trust between communities and decision-makers.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="team-section" id="team">
        <div class="container">
            <h2 class="section-title text-center">Meet the Team</h2>
            <p class="section-description text-center">A multidisciplinary group passionate about democratizing urban planning</p>
            <div class="team-grid">
                {team.map((member) => (
                    <a href={member.linkedin || '#'} target="_blank" rel="noopener noreferrer" style="text-decoration: none; color: inherit;">
                    <div class="team-member">
                        <div class="member-photo">
                            {member.photo ? (
                                <img
                                    src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${member.photo}`}
                                    alt={member.full_name}
                                    style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;"
                                />
                            ) : (
                                <div class="photo-placeholder">Photo</div>
                            )}
                        </div>
                        <h3 class="member-name">{member.full_name}</h3>
                        <p class="member-role">{member.job_title}</p>
                        <p class="member-bio">{member.bio}</p>
                        {member.email && (
                            <div class="member-social">
                                <a href={`mailto:${member.email}`} class="social-icon">✉️</a>
                            </div>
                        )}
                    </div>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h2>Want to Work With Us?</h2>
            <p>We're always looking for passionate people who want to make cities better for everyone.</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-outline btn-large">Get in Touch</a>
            </div>
        </div>
    </section>

</Layout>