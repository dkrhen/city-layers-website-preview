---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Services - City Layers">

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">Our Services</h1>
            <p class="page-subtitle">We help communities, municipalities, and organisations design better cities — together.</p>
        </div>
    </section>

    <!-- Intro Statement -->
    <section style="padding: 80px 2rem 40px;">
        <div class="container">
            <div class="story-content">
                <div class="story-text">
                    <h2 class="section-title">Participation That Creates Real Change</h2>
                    <p>City Layers combines digital innovation with deep urban planning expertise to make community participation meaningful, inclusive, and impactful. We work with cities, municipalities, developers, and civic organisations across Europe to ensure that the people most affected by urban decisions have a genuine voice in shaping them.</p>
                    <p>Our services span the full lifecycle of urban participation — from designing engagement strategies and running digital consultations, to analysing community data and translating insights into actionable recommendations for decision-makers.</p>
                </div>
                <div class="story-image">
                    <div class="image-placeholder">
                        <div class="placeholder-text">Services overview image</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Services -->
    <section style="padding: 60px 2rem;">
        <div class="container">
            <div class="section-header" style="margin-bottom: 3rem;">
                <h2 class="section-title">What We Do</h2>
            </div>

            <!-- Service 1 -->
            <div class="story-content" style="margin-bottom: 5rem;">
                <div class="story-text">
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Digital Community Engagement</h3>
                    <p>We design and run digital participation processes that reach the full diversity of your community — not just the usual voices. Using our platform, residents can share ideas, respond to proposals, and map their lived experiences directly onto your project area.</p>
                    <p>Our engagement tools are accessible across devices, available in multiple languages, and designed to be intuitive for people of all ages and technical backgrounds.</p>
                    <ul style="margin-top: 1rem; padding-left: 1.5rem; line-height: 2;">
                        <li>Interactive mapping and spatial feedback</li>
                        <li>Custom surveys and idea boards</li>
                        <li>Multi-language participation support</li>
                        <li>Accessible design for all community members</li>
                    </ul>
                </div>
                <div class="story-image">
                    <div class="image-placeholder">
                        <div class="placeholder-text">Community engagement image</div>
                    </div>
                </div>
            </div>

            <!-- Service 2 -->
            <div class="story-content" style="margin-bottom: 5rem; direction: rtl;">
                <div class="story-text" style="direction: ltr;">
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Data Analysis & Insight Reporting</h3>
                    <p>Raw participation data only has value when it can be understood and acted upon. Our team of urban analysts and data scientists transform community responses into clear, evidence-based insights that support confident decision-making.</p>
                    <p>We go beyond basic statistics — identifying spatial patterns, sentiment trends, and underrepresented perspectives to give you a complete picture of your community's priorities.</p>
                    <ul style="margin-top: 1rem; padding-left: 1.5rem; line-height: 2;">
                        <li>AI-powered theme and sentiment analysis</li>
                        <li>Spatial heat maps and geographic insights</li>
                        <li>Stakeholder-ready summary reports</li>
                        <li>Natural language querying of your data</li>
                    </ul>
                </div>
                <div class="story-image" style="direction: ltr;">
                    <div class="image-placeholder">
                        <div class="placeholder-text">Data analysis image</div>
                    </div>
                </div>
            </div>

            <!-- Service 3 -->
            <div class="story-content" style="margin-bottom: 5rem;">
                <div class="story-text">
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Participation Strategy & Facilitation</h3>
                    <p>Effective participation doesn't happen by accident. We work with your team from the outset to design a participation strategy that is proportionate to your project, meaningful for your community, and defensible to your stakeholders.</p>
                    <p>Our experienced facilitators can run workshops, public events, and stakeholder sessions — either in person or digitally — ensuring every voice is heard and recorded.</p>
                    <ul style="margin-top: 1rem; padding-left: 1.5rem; line-height: 2;">
                        <li>Participation strategy development</li>
                        <li>Workshop design and facilitation</li>
                        <li>Stakeholder mapping and engagement planning</li>
                        <li>Public consultation management</li>
                    </ul>
                </div>
                <div class="story-image">
                    <div class="image-placeholder">
                        <div class="placeholder-text">Facilitation image</div>
                    </div>
                </div>
            </div>

            <!-- Service 4 -->
            <div class="story-content" style="margin-bottom: 2rem; direction: rtl;">
                <div class="story-text" style="direction: ltr;">
                    <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">Platform Licensing & Technical Integration</h3>
                    <p>For organisations that want to run participation processes independently, we offer City Layers as a licensed platform. Our team handles onboarding, training, and ongoing technical support — so your team can focus on engaging your community, not managing software.</p>
                    <p>We also offer API access and custom integrations for organisations that need to connect City Layers with existing planning tools, GIS systems, or internal dashboards.</p>
                    <ul style="margin-top: 1rem; padding-left: 1.5rem; line-height: 2;">
                        <li>Platform licensing for municipalities and consultancies</li>
                        <li>Team training and onboarding</li>
                        <li>API access and custom integrations</li>
                        <li>White-label options available</li>
                    </ul>
                </div>
                <div class="story-image" style="direction: ltr;">
                    <div class="image-placeholder">
                        <div class="placeholder-text">Platform image</div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- Who We Work With -->
    <section style="padding: 80px 2rem; background: var(--gray-50, #f9f9f9);">
        <div class="container">
            <div class="section-header" style="text-align: center; margin-bottom: 3rem;">
                <h2 class="section-title">Who We Work With</h2>
                <p class="section-description">City Layers serves a broad range of clients across the public and private sectors</p>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-number">🏛️</div>
                    <h3>Municipalities & Local Government</h3>
                    <p>Supporting planning departments in running legally compliant, meaningful public consultations for planning applications, transport schemes, and neighborhood strategies.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-number">🏗️</div>
                    <h3>Developers & Real Estate</h3>
                    <p>Helping developers build community trust and demonstrate genuine engagement as part of the planning process — reducing risk and building project legitimacy.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-number">🤝</div>
                    <h3>NGOs & Civic Organisations</h3>
                    <p>Empowering community groups and civic organisations to run their own participation processes and advocate effectively for their neighborhoods.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-number">🔬</div>
                    <h3>Research & Academia</h3>
                    <p>Providing urban researchers with powerful data collection and analysis tools for studying community behaviour, spatial preferences, and participation patterns.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
        <div class="container">
            <h2>Let's Work Together</h2>
            <p>Tell us about your project and we'll find the right approach for your community.</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-primary btn-large">Get in Touch</a>
                <a href="/projects" class="btn btn-outline btn-large">See Our Work</a>
            </div>
        </div>
    </section>

</Layout>