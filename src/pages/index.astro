---
import Layout from '../layouts/Layout.astro';
import directus from '../lib/directus';
import { readItems } from '@directus/sdk';

const partnersRes = await directus.request(
    readItems('partners', {
        fields: ['name', 'logo', 'sort'],
        sort: ['sort'],
    })
);
const partners = partnersRes;
---

<Layout title="City Layers - Inclusive Urban Participation Platform">

    <section class="hero" id="hero">
        <div class="hero-image"></div>
        <div class="container hero-content">
            <div class="hero-eyebrow">Kalamata · est. 2024</div>
            <h1 class="hero-title">
                <span class="rotor"><span id="rotor-word" class="word">City</span></span><br/>
                Layers
            </h1>
            <p class="hero-subtitle">Revealing urban complexities through everyday experiences.   A platform for cities that want to listen to the people who live in them.</p>
            <div class="hero-cta">
                <a href="/contact" class="btn btn-primary btn-large">Get started</a>
                <a href="/projects" class="btn btn-outline-light btn-large">View projects</a>
            </div>
        </div>
        <div class="hero-meta">
            37.02858° N, 22.10994° E<br/>
            Kalamata, Municipal Railway Park
        </div>
    </section>

    <section class="partners">
        <div class="partner-eyebrow">
            <span>Working with cities and research partners across Europe</span>
        </div>
        <div class="partners-rail" id="partners-rail">
            {/* Render 4 copies so there are always logos visible at any screen width */}
            {[...Array(4)].map(() =>
                partners.map((partner) => (
                    <img
                        class="partner-logo"
                        src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${partner.logo}`}
                        alt={partner.name}
                    />
                ))
            )}
        </div>
    </section>

    <section class="what-we-do" style="padding-top: 2rem;">
    <div class="container">
        <div class="what-we-do-inner">
            <div class="what-we-do-image">
                <img src="/landing_about.png" alt="City Layers in action" />
            </div>
            <div class="what-we-do-text">
                <h2 class="section-title">From Urban Challenges To Everyday Experience</h2>
                <p class="section-description">City Layers is a transdisciplinary framework that translates complex urban phenomena into accessible layers of everyday experience. Our citizen science methodology bridges community insights with expert knowledge, while our digital platform enables intuitive participatory mapping and sophisticated data visualization</p>
            </div>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-number">01</div>
                <h3>Interactive Mapping</h3>
                <p>Visualize ideas and feedback directly on maps, making spatial planning intuitive for everyone.</p>
            </div>
            <div class="feature-card">
                <div class="feature-number">02</div>
                <h3>Easy Participation</h3>
                <p>No technical expertise required. Our platform is designed for all community members to contribute.</p>
            </div>
            <div class="feature-card">
                <div class="feature-number">03</div>
                <h3>Real Impact</h3>
                <p>Transform community input into comprehensive data that drives meaningful urban development.</p>
            </div>
        </div>
    </div>
</section>

    <section class="demo-section">
        <div class="container">
            <div style="text-align: center; margin-bottom: 3rem;">
                <h2 class="section-title">Experience the Process</h2>
                <p class="section-description">See how City Layers makes urban participation simple and engaging</p>
            </div>

            <div style="
                width: 100%;
                max-width: 800px;
                margin: 0 auto 3rem;
                min-height: 360px;
                background: var(--gray-100, #f0f0f0);
                border-radius: 12px;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                border: 2px dashed var(--gray-300, #ccc);
                gap: 1rem;
            ">
                <div style="font-size: 3rem;">▶️</div>
                <p style="font-size: 1.1rem; font-weight: 500; color: var(--text-medium, #666);">Video will be here</p>
                <p style="font-size: 0.9rem; color: var(--text-light, #999);">Platform walkthrough coming soon</p>
            </div>

            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-bottom: 3rem;">
                <div style="text-align: center;">
                    <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; margin: 0 auto 0.75rem;">01</div>
                    <strong>Launch Your Project</strong>
                    <p style="font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-medium, #666);">Define your urban planning goals and area of focus</p>
                </div>
                <div style="text-align: center;">
                    <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; margin: 0 auto 0.75rem;">02</div>
                    <strong>Invite Community</strong>
                    <p style="font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-medium, #666);">Share with residents through multiple channels</p>
                </div>
                <div style="text-align: center;">
                    <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; margin: 0 auto 0.75rem;">03</div>
                    <strong>Collect Insights</strong>
                    <p style="font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-medium, #666);">Gather location-based feedback and ideas</p>
                </div>
                <div style="text-align: center;">
                    <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; margin: 0 auto 0.75rem;">04</div>
                    <strong>Analyze & Act</strong>
                    <p style="font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-medium, #666);">Turn data into actionable urban improvements</p>
                </div>
            </div>
        </div>
    </section>

    <div style="margin-top: 3rem;"></div>

    <section class="cta-section">
        <div class="container">
            <h2>Ready to Transform Urban Participation?</h2>
            <p>Join cities and communities already using City Layers to create better urban spaces together.</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-outline btn-large">Get in Touch</a>
            </div>
        </div>
    </section>

</Layout>

<style>
/* ── Hero ───────────────────────────────────────────────── */
.hero {
    position: relative;
    min-height: 760px;
    color: #fff;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding-bottom: 96px;
    padding-top: 140px;
    z-index: 1;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4);
}

.hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/CL-Hero Image.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.hero-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg,
            rgba(14,14,77,0.40) 0%,
            rgba(14,14,77,0.20) 40%,
            rgba(14,14,77,0.78) 100%),
        linear-gradient(110deg,
            rgba(14,14,77,0.55) 0%,
            rgba(14,14,77,0.05) 60%);
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 1;
    max-width: 920px;
    margin-left: 0;
    margin-right: auto;
    text-align: left;
}

.hero-eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
}

.hero-eyebrow::before {
    content: "";
    display: block;
    width: 36px;
    height: 1px;
    background: rgba(255,255,255,0.5);
}

.hero-title {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(48px, 9vw, 128px);
    font-weight: 600;
    letter-spacing: -0.034em;
    line-height: 0.96;
    color: #fff;
    margin: 0;
    overflow: visible;
}

.rotor {
    display: inline-block;
    position: relative;
    white-space: nowrap;
}

.word {
    display: inline-block;
    background: linear-gradient(95deg, #82A8FF 0%, #7BC5FF 45%, #82E6D3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    padding-bottom: 0.12em;
    padding-right: 0.1em;
    transition: opacity 600ms ease, transform 600ms ease, filter 600ms ease;
    will-change: opacity, transform;
}

.word.out {
    opacity: 0;
    transform: translateY(-12px);
    filter: blur(4px);
}

.word.in {
    opacity: 0;
    transform: translateY(12px);
    filter: blur(4px);
}

.hero-subtitle {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 300;
    color: rgba(255,255,255,0.84);
    margin: 36px 0 0;
    max-width: 640px;
    line-height: 1.4;
}

.hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 40px;
    flex-wrap: wrap;
}

.btn-outline-light {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255,255,255,0.5);
}

.btn-outline-light:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.9);
}

.hero-meta {
    position: absolute;
    right: 32px;
    bottom: 32px;
    z-index: 1;
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    color: rgba(255,255,255,0.55);
    text-align: right;
    line-height: 1.6;
    letter-spacing: 0.04em;
}

/* ── Partners marquee ───────────────────────────────────── */
.partners {
    position: relative;
    background: #ffffff;
    padding: 28px 0;
    overflow: hidden;
}

.partner-eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-light);
    text-align: center;
    margin-bottom: 22px;
}

.partner-eyebrow span {
    display: inline-flex;
    align-items: center;
    gap: 14px;
}

.partner-eyebrow span::before,
.partner-eyebrow span::after {
    content: "";
    width: 36px;
    height: 1px;
    background: var(--gray-300);
}

.partners-rail {
    display: flex;
    align-items: center;
    gap: 64px;
    width: max-content;
}

.partner-logo {
    height: 64px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    opacity: 0.8;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
}

.partner-logo:hover {
    opacity: 1;
}

/* Edge fades */
.partners::before,
.partners::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 1;
    pointer-events: none;
}

.partners::before {
    left: 0;
    background: linear-gradient(90deg, #ffffff, transparent);
}

.partners::after {
    right: 0;
    background: linear-gradient(-90deg, #ffffff, transparent);
}
</style>

<script is:inline>
/* ── Partners marquee ───────────────────────────────────── */
window.addEventListener('load', () => {
    const rail = document.getElementById('partners-rail');
    if (!rail) return;

    // One "set" is 1/4 of total logos (we rendered 4 copies)
    const oneSet = rail.scrollWidth / 4;
    let pos = 0;
    const speed = 0.5;

    function tick() {
        pos += speed;
        if (pos >= oneSet) {
            pos = 0;
        }
        rail.style.transform = `translateX(-${pos}px)`;
        requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
});

/* ── Rotating word ──────────────────────────────────────── */
const WORDS = ['City', 'Mobility', 'Safety', 'Nature', 'Experience'];
let idx = 0;

setInterval(() => {
    const el = document.getElementById('rotor-word');
    if (!el) return;

    el.classList.add('out');

    setTimeout(() => {
        idx = (idx + 1) % WORDS.length;
        el.textContent = WORDS[idx];
        el.classList.remove('out');
        el.classList.add('in');
        requestAnimationFrame(() => requestAnimationFrame(() => {
            el.classList.remove('in');
        }));
    }, 600);
}, 2500);
</script>