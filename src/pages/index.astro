---
import Layout from '../layouts/Layout.astro';
---

<Layout title="City Layers - Inclusive Urban Participation Platform">

    <section class="hero">
        <div class="hero-content">
            <h1 class="hero-title">A New Way to Shape Our Cities!</h1>
            <p class="hero-subtitle">Empowering communities through inclusive, modern, and accessible urban participation tools</p>
            <div class="hero-cta">
                <a href="/contact" class="btn btn-primary">Get Started</a>
                <a href="/project" class="btn btn-secondary">View Projects</a>
            </div>
        </div>
        <div class="hero-visual">
            <div class="floating-card">
                <div class="card-icon">🗺️</div>
                <h3>Interactive Mapping</h3>
                <p>Engage citizens through visual collaboration</p>
            </div>
            <div class="floating-card card-delay-1">
                <div class="card-icon">💬</div>
                <h3>Community Voice</h3>
                <p>Amplify local perspectives and needs</p>
            </div>
            <div class="floating-card card-delay-2">
                <div class="card-icon">📊</div>
                <h3>Data-Driven Insights</h3>
                <p>Transform feedback into actionable solutions</p>
            </div>
        </div>
    </section>

    <section class="what-we-do">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Solving Urban Challenges Together</h2>
                <p class="section-description">City Layers is a digital participation platform that makes urban planning accessible, inclusive, and effective. We bridge the gap between communities and decision-makers through innovative technology.</p>
            </div>
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-number">01</div>
                    <h3>Interactive Mapping</h3>
                    <p>Visualize ideas and feedback directly on maps, making spatial planning intuitive for everyone.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-number">02</div>
                    <h3>Easy Participation</h3>
                    <p>No technical expertise required. Our platform is designed for all community members to contribute.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-number">03</div>
                    <h3>Real Impact</h3>
                    <p>Transform community input into comprehensive data that drives meaningful urban development.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="demo-section">
        <div class="container">
            <h2 class="section-title">Experience the Process</h2>
            <p class="section-description">See how City Layers makes urban participation simple and engaging</p>
            <div class="demo-container">
                <div class="map-demo">
                    <div class="map-interface">
                        <div class="map-header">
                            <h3>Sample Project: Downtown Revitalization</h3>
                            <div class="map-stats">
                                <span class="stat"><strong>127</strong> Participants</span>
                                <span class="stat"><strong>45</strong> Ideas</span>
                                <span class="stat"><strong>12</strong> Zones</span>
                            </div>
                        </div>
                        <div class="map-canvas">
                            <div class="map-placeholder">
                                <div class="map-marker" style="top: 30%; left: 40%;" data-category="green">
                                    <span class="marker-dot green"></span>
                                    <div class="marker-tooltip">More green spaces</div>
                                </div>
                                <div class="map-marker" style="top: 60%; left: 60%;" data-category="transport">
                                    <span class="marker-dot blue"></span>
                                    <div class="marker-tooltip">Bike lane needed</div>
                                </div>
                                <div class="map-marker" style="top: 45%; left: 70%;" data-category="community">
                                    <span class="marker-dot orange"></span>
                                    <div class="marker-tooltip">Community center</div>
                                </div>
                                <div class="map-marker" style="top: 75%; left: 35%;" data-category="safety">
                                    <span class="marker-dot red"></span>
                                    <div class="marker-tooltip">Better lighting</div>
                                </div>
                            </div>
                        </div>
                        <div class="map-legend">
                            <div class="legend-item"><span class="legend-dot green"></span> Green Spaces</div>
                            <div class="legend-item"><span class="legend-dot blue"></span> Transport</div>
                            <div class="legend-item"><span class="legend-dot orange"></span> Community</div>
                            <div class="legend-item"><span class="legend-dot red"></span> Safety</div>
                        </div>
                    </div>
                </div>
                <div class="demo-info">
                    <h3>How It Works</h3>
                    <ol class="process-steps">
                        <li>
                            <strong>Launch Your Project</strong>
                            <p>Define your urban planning goals and area of focus</p>
                        </li>
                        <li>
                            <strong>Invite Community</strong>
                            <p>Share with residents through multiple channels</p>
                        </li>
                        <li>
                            <strong>Collect Insights</strong>
                            <p>Gather location-based feedback and ideas</p>
                        </li>
                        <li>
                            <strong>Analyze & Act</strong>
                            <p>Turn data into actionable urban improvements</p>
                        </li>
                    </ol>
                    <a href="/contact" class="btn btn-primary">Start Your Project</a>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h2>Ready to Transform Urban Participation?</h2>
            <p>Join cities and communities already using City Layers to create better urban spaces together.</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-primary btn-large">Get in Touch</a>
            </div>
        </div>
    </section>

</Layout>