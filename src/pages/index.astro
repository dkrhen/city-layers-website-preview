---
import Layout from '../layouts/Layout.astro';
import directus from '../lib/directus';
import { readItems } from '@directus/sdk';

const partnersRes = await directus.request(
    readItems('partners', {
        fields: ['name', 'logo', 'sort'],
        sort: ['sort'],
    })
);
const partners = partnersRes;
---

<Layout title="City Layers - Inclusive Urban Participation Platform">

    <section class="hero" id="hero">
        <div class="hero-image"></div>
        <div class="container hero-content">
            <div class="hero-eyebrow">Kalamata · est. 2024</div>
            <h1 class="hero-title">
                <span class="rotor"><span id="rotor-word" class="word">City</span></span><br/>
                Layers
            </h1>
            <p class="hero-subtitle">Revealing urban complexities through everyday experiences. A platform for cities that want to listen to the people who live in them.</p>
            <div class="hero-cta">
                <a href="/contact" class="btn btn-primary btn-large">Get started</a>
                <a href="/projects" class="btn btn-outline-light btn-large">View projects</a>
            </div>
        </div>
        <div class="hero-meta">
            37.02858° N, 22.10994° E<br/>
            Kalamata, Municipal Railway Park
        </div>
    </section>

    <section class="partners">
        <div class="partner-eyebrow">
            <span>Working with cities and research partners across Europe</span>
        </div>
        <div class="partners-rail" id="partners-rail">
            {[...Array(4)].map(() =>
                partners.map((partner) => (
                    <img
                        class="partner-logo"
                        src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${partner.logo}`}
                        alt={partner.name}
                    />
                ))
            )}
        </div>
    </section>

    <section class="what-we-do">
    <div class="container">
        <div class="wwd-eyebrow">What we do</div>
        <h2 class="wwd-headline">A city that doesn't listen to its people <em>slowly loses its soul.</em></h2>
        <div class="wwd-grid">
            <div>
                <p class="wwd-lede">Streets that feel unsafe at night. Parks nobody uses. Intersections that confuse. The sense that a neighbourhood was designed for someone who doesn't live there.</p>
                <p class="wwd-lede">City Layers gives these feelings a voice and a location. We are a transdisciplinary platform that bridges citizen science with urban planning expertise. Using our inhouse digital tool by collecting lived experience from communities and translating it into actionable <em>place intelligence</em> for decision-makers.</p>
            </div>
            <aside class="wwd-aside">
                <p>A platform co-developed with planners, architects, and engaged residents across Europe.</p>
                <p>Funded in part by multiple European initiatives and and alligned with SDG Goals at its core.</p>
                <div class="wwd-pin-row">
                    <span class="wwd-pin-dot"></span>
                    Currently active in 3 countries.
                </div>
            </aside>
        </div>

        <div class="capabilities">

            <article class="cap">
                <div class="cap-bg">
                    <svg viewBox="0 0 360 360" preserveAspectRatio="xMidYMid slice">
                        <defs>
                            <pattern id="cap1-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                                <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(26,26,128,0.06)" stroke-width="1"/>
                            </pattern>
                        </defs>
                        <rect width="360" height="360" fill="url(#cap1-grid)"/>
                        <g fill="rgba(26,26,128,0.16)">
                            <circle cx="80" cy="220" r="4"/>
                            <circle cx="140" cy="260" r="5"/>
                            <circle cx="200" cy="200" r="4"/>
                            <circle cx="260" cy="250" r="6"/>
                            <circle cx="310" cy="230" r="4"/>
                            <circle cx="50" cy="290" r="4"/>
                        </g>
                        <g fill="rgba(107,107,255,0.5)">
                            <circle cx="180" cy="290" r="6"/>
                            <circle cx="290" cy="310" r="5"/>
                        </g>
                    </svg>
                </div>
                <div class="cap-num">01 / Layer</div>
                <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="10" r="3"/>
                    <path d="M12 2a8 8 0 0 0-8 8c0 6 8 12 8 12s8-6 8-12a8 8 0 0 0-8-8z"/>
                </svg>
                <h3 class="cap-title">Participatory Mapping</h3>
                <p class="cap-body">Residents pin feelings, observations, and ideas directly onto the city. Every comment lives on the map, anchored to the place it describes. A Geo-located representation of human experience.</p>
                <a href="/projects" class="cap-link">See it in action
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
            </article>

            <article class="cap">
                <div class="cap-bg">
                    <svg viewBox="0 0 360 360" preserveAspectRatio="xMidYMid slice">
                        <g fill="none" stroke="rgba(26,26,128,0.10)" stroke-width="1">
                            <path d="M -20 80 Q 80 30 200 60 T 380 90"/>
                            <path d="M -20 120 Q 80 70 200 100 T 380 130"/>
                            <path d="M -20 160 Q 80 110 200 140 T 380 170"/>
                            <path d="M -20 200 Q 80 150 200 180 T 380 210"/>
                            <path d="M -20 240 Q 80 190 200 220 T 380 250"/>
                            <path d="M -20 280 Q 80 230 200 260 T 380 290"/>
                            <path d="M -20 320 Q 80 270 200 300 T 380 330"/>
                        </g>
                        <g fill="none" stroke="rgba(96,212,192,0.42)" stroke-width="1.4">
                            <path d="M -20 180 Q 80 130 200 160 T 380 190"/>
                        </g>
                    </svg>
                </div>
                <div class="cap-num">02 / Layer</div>
                <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <path d="M3 9h18M9 21V9"/>
                </svg>
                <h3 class="cap-title">Place Intelligence</h3>
                <p class="cap-body">A methodology that combines participatory methods and digital tools in order to achieve advanced analytics by clustering signals, surfacing patterns, and revealing the urban dynamics that lie beneath the numbers.</p>
                <a href="/approach" class="cap-link">Read the methodology
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
            </article>

            <article class="cap">
                <div class="cap-bg">
                    <svg viewBox="0 0 360 360" preserveAspectRatio="xMidYMid slice">
                        <defs>
                            <pattern id="cap3-grid" width="48" height="48" patternUnits="userSpaceOnUse">
                                <path d="M 48 0 L 0 0 0 48" fill="none" stroke="rgba(26,26,128,0.06)" stroke-width="1"/>
                            </pattern>
                        </defs>
                        <rect width="360" height="360" fill="url(#cap3-grid)"/>
                        <g fill="rgba(107,107,255,0.18)">
                            <rect x="40" y="240" width="22" height="60"/>
                            <rect x="78" y="220" width="22" height="80"/>
                            <rect x="116" y="190" width="22" height="110"/>
                            <rect x="154" y="170" width="22" height="130"/>
                            <rect x="192" y="150" width="22" height="150"/>
                            <rect x="230" y="180" width="22" height="120"/>
                            <rect x="268" y="140" width="22" height="160"/>
                            <rect x="306" y="120" width="22" height="180"/>
                        </g>
                        <g fill="rgba(96,212,192,0.6)">
                            <rect x="306" y="120" width="22" height="40"/>
                            <rect x="268" y="140" width="22" height="30"/>
                            <rect x="192" y="150" width="22" height="34"/>
                        </g>
                    </svg>
                </div>
                <div class="cap-num">03 / Layer</div>
                <svg class="cap-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 3v18h18"/>
                    <polyline points="7 14 11 10 15 13 21 7"/>
                </svg>
                <h3 class="cap-title">Decision Support</h3>
                <p class="cap-body">Evidence-based decision support. Actionable case files that equip planners and architects to connect real community signals with the spatial data and policy levers that drive impact.</p>
                <a href="/services" class="cap-link">Explore our services
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
            </article>

        </div>
    </div>
</section>

<section class="demo-section" style="position: relative; overflow: hidden;">
    <svg style="position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: 0.5;" viewBox="0 0 1200 500" preserveAspectRatio="xMidYMid slice">
        <g fill="none" stroke="rgba(26,26,128,0.10)" stroke-width="1">
            <path d="M -20 80 Q 200 30 500 60 T 1220 90"/>
            <path d="M -20 130 Q 200 80 500 110 T 1220 140"/>
            <path d="M -20 180 Q 200 130 500 160 T 1220 190"/>
            <path d="M -20 230 Q 200 180 500 210 T 1220 240"/>
            <path d="M -20 280 Q 200 230 500 260 T 1220 290"/>
            <path d="M -20 330 Q 200 280 500 310 T 1220 340"/>
            <path d="M -20 380 Q 200 330 500 360 T 1220 390"/>
            <path d="M -20 430 Q 200 380 500 410 T 1220 440"/>
        </g>
        <g fill="none" stroke="rgba(96,212,192,0.42)" stroke-width="1.4">
            <path d="M -20 230 Q 200 180 500 210 T 1220 240"/>
        </g>
    </svg>
    <div class="container">
        <div style="text-align: center; margin-bottom: 3rem;">
            <h2 class="section-title">Experience the Process</h2>
            <p class="section-description">See how City Layers makes urban participation simple and engaging</p>
        </div>

        <div style="
            width: 100%;
            max-width: 800px;
            margin: 0 auto 3rem;
            min-height: 360px;
            background: var(--gray-100, #f0f0f0);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 2px dashed var(--gray-300, #ccc);
            gap: 1rem;
        ">
            <div style="font-size: 3rem;">▶️</div>
            <p style="font-size: 1.1rem; font-weight: 500; color: var(--text-medium, #666);">Video will be here</p>
            <p style="font-size: 0.9rem; color: var(--text-light, #999);">Platform walkthrough coming soon</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-bottom: 3rem;">
            <div style="text-align: center;">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; margin: 0 auto 0.75rem;">01</div>
                <strong>Launch Your Project</strong>
                <p style="font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-medium, #666);">Define your urban planning goals and area of focus</p>
            </div>
            <div style="text-align: center;">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; margin: 0 auto 0.75rem;">02</div>
                <strong>Invite Community</strong>
                <p style="font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-medium, #666);">Share with residents through multiple channels</p>
            </div>
            <div style="text-align: center;">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; margin: 0 auto 0.75rem;">03</div>
                <strong>Collect Insights</strong>
                <p style="font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-medium, #666);">Gather location-based feedback and ideas</p>
            </div>
            <div style="text-align: center;">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: var(--primary-color); color: white; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; margin: 0 auto 0.75rem;">04</div>
                <strong>Analyze & Act</strong>
                <p style="font-size: 0.9rem; margin-top: 0.5rem; color: var(--text-medium, #666);">Turn data into actionable urban improvements</p>
            </div>
        </div>
    </div>
</section>

    <section class="cta-section">
        <div class="container">
            <h2>Ready to Transform Urban Participation?</h2>
            <p>Join cities and communities already using City Layers to create better urban spaces together.</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-outline btn-large">Get in Touch</a>
            </div>
        </div>
    </section>

</Layout>

<style>
/* ── Hero ───────────────────────────────────────────────── */
.hero {
    position: relative;
    min-height: 760px;
    color: #fff;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding-bottom: 96px;
    padding-top: 140px;
    z-index: 1;
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4);
}

.hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/CL-Hero Image.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.hero-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
        linear-gradient(180deg,
            rgba(14,14,77,0.40) 0%,
            rgba(14,14,77,0.20) 40%,
            rgba(14,14,77,0.78) 100%),
        linear-gradient(110deg,
            rgba(14,14,77,0.55) 0%,
            rgba(14,14,77,0.05) 60%);
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 1;
    max-width: 920px;
    margin-left: 0;
    margin-right: auto;
    text-align: left;
}

.hero-eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.75);
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
}

.hero-eyebrow::before {
    content: "";
    display: block;
    width: 36px;
    height: 1px;
    background: rgba(255,255,255,0.5);
}

.hero-title {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(48px, 9vw, 128px);
    font-weight: 600;
    letter-spacing: -0.034em;
    line-height: 0.96;
    color: #fff;
    margin: 0;
    overflow: visible;
}

.rotor {
    display: inline-block;
    position: relative;
    white-space: nowrap;
}

.word {
    display: inline-block;
    background: linear-gradient(95deg, #82A8FF 0%, #7BC5FF 45%, #82E6D3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    padding-bottom: 0.12em;
    padding-right: 0.1em;
    transition: opacity 600ms ease, transform 600ms ease, filter 600ms ease;
    will-change: opacity, transform;
}

.word.out {
    opacity: 0;
    transform: translateY(-12px);
    filter: blur(4px);
}

.word.in {
    opacity: 0;
    transform: translateY(12px);
    filter: blur(4px);
}

.hero-subtitle {
    font-family: 'Figtree', sans-serif;
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 300;
    color: rgba(255,255,255,0.84);
    margin: 36px 0 0;
    max-width: 590px;
    line-height: 1.4;
}

.hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 40px;
    flex-wrap: wrap;
}

.btn-outline-light {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255,255,255,0.5);
}

.btn-outline-light:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.9);
}

.hero-meta {
    position: absolute;
    right: 32px;
    bottom: 32px;
    z-index: 1;
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    color: rgba(255,255,255,0.55);
    text-align: right;
    line-height: 1.6;
    letter-spacing: 0.04em;
}

/* ── Partners marquee ───────────────────────────────────── */
.partners {
    position: relative;
    background: #ffffff;
    padding: 28px 0;
    overflow: hidden;
}

.partner-eyebrow {
    font-family: 'Figtree', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-light);
    text-align: center;
    margin-bottom: 22px;
}

.partner-eyebrow span {
    display: inline-flex;
    align-items: center;
    gap: 14px;
}

.partner-eyebrow span::before,
.partner-eyebrow span::after {
    content: "";
    width: 36px;
    height: 1px;
    background: var(--gray-300);
}

.partners-rail {
    display: flex;
    align-items: center;
    gap: 64px;
    width: max-content;
}

.partner-logo {
    height: 64px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    opacity: 0.8;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
}

.partner-logo:hover {
    opacity: 1;
}

.partners::before,
.partners::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 120px;
    z-index: 1;
    pointer-events: none;
}

.partners::before {
    left: 0;
    background: linear-gradient(90deg, #ffffff, transparent);
}

.partners::after {
    right: 0;
    background: linear-gradient(-90deg, #ffffff, transparent);
}

/* ── Capability Cards ────────────────────────────────────── */
.capabilities {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.cap {
    position: relative;
    background: var(--white);
    border-radius: 14px;
    padding: 32px 30px 30px;
    border: 1px solid var(--gray-200);
    overflow: hidden;
    min-height: 360px;
    display: flex;
    flex-direction: column;
    transition: transform 320ms ease, box-shadow 320ms ease;
}

.cap:hover {
    transform: translateY(-3px);
    box-shadow: 0 2px 0 rgba(26,26,128,0.04), 0 18px 36px -16px rgba(26,26,128,0.18);
}

.cap-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.7;
}

.cap-bg svg {
    width: 100%;
    height: 100%;
}

.cap-num {
    font-size: 11px;
    color: var(--primary-light);
    letter-spacing: 0.06em;
    z-index: 1;
    position: relative;
}

.cap-icon {
    width: 44px;
    height: 44px;
    margin-top: 18px;
    color: var(--primary-color);
    z-index: 1;
    position: relative;
}

.cap-title {
    font-family: var(--font-figtree);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.018em;
    color: var(--primary-color);
    margin: 24px 0 12px;
    line-height: 1.2;
    z-index: 1;
    position: relative;
}

.cap-body {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-medium);
    margin: 0;
    z-index: 1;
    position: relative;
    flex: 1;
}

.cap-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--primary-color);
    margin-top: 24px;
    z-index: 1;
    position: relative;
    transition: gap 220ms ease;
    text-decoration: none;
}

.cap:hover .cap-link {
    gap: 12px;
}

.cap-link svg {
    width: 14px;
    height: 14px;
}

@media (max-width: 960px) {
    .capabilities {
        grid-template-columns: 1fr;
    }
}
</style>

<script is:inline>
/* ── Partners marquee ───────────────────────────────────── */
window.addEventListener('load', () => {
    const rail = document.getElementById('partners-rail');
    if (!rail) return;

    const oneSet = rail.scrollWidth / 4;
    let pos = 0;
    const speed = 0.5;

    function tick() {
        pos += speed;
        if (pos >= oneSet) {
            pos = 0;
        }
        rail.style.transform = `translateX(-${pos}px)`;
        requestAnimationFrame(tick);
    }

    requestAnimationFrame(tick);
});

/* ── Rotating word ──────────────────────────────────────── */
const WORDS = ['City', 'Mobility', 'Noise', 'Safety', 'Nature', 'Experience'];
let idx = 0;

setInterval(() => {
    const el = document.getElementById('rotor-word');
    if (!el) return;

    el.classList.add('out');

    setTimeout(() => {
        idx = (idx + 1) % WORDS.length;
        el.textContent = WORDS[idx];
        el.classList.remove('out');
        el.classList.add('in');
        requestAnimationFrame(() => requestAnimationFrame(() => {
            el.classList.remove('in');
        }));
    }, 600);
}, 1800);
</script>