---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pricing - City Layers">

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">Pricing Plans</h1>
            <p class="page-subtitle">Flexible solutions for communities and organizations of all sizes</p>
        </div>
    </section>

    <section style="padding: 100px 2rem;">
        <div class="container">
            <div class="pricing-grid">
                <div class="pricing-card">
                    <h3 class="plan-name">Starter</h3>
                    <p class="plan-description">Perfect for small community projects and pilot initiatives</p>
                    <div class="plan-price">€2,500</div>
                    <span class="plan-period">per project</span>
                    <ul class="plan-features">
                        <li>Up to 200 participants</li>
                        <li>Single project area</li>
                        <li>Basic interactive mapping</li>
                        <li>Standard survey tools</li>
                        <li>Data export (CSV)</li>
                        <li>Email support</li>
                        <li>30 days active period</li>
                    </ul>
                    <a href="/contact" class="btn btn-secondary plan-cta">Get Started</a>
                </div>

                <div class="pricing-card featured">
                    <h3 class="plan-name">Professional</h3>
                    <p class="plan-description">Ideal for municipalities and urban planning consultancies</p>
                    <div class="plan-price">€8,500</div>
                    <span class="plan-period">per project</span>
                    <ul class="plan-features">
                        <li>Up to 1,000 participants</li>
                        <li>Multiple project areas</li>
                        <li>Advanced mapping & visualization</li>
                        <li>Custom survey design</li>
                        <li>Heat maps & analytics dashboard</li>
                        <li>White-label option</li>
                        <li>Priority support</li>
                        <li>90 days active period</li>
                        <li>Training session included</li>
                    </ul>
                    <a href="/contact" class="btn btn-primary plan-cta">Get Started</a>
                </div>

                <div class="pricing-card">
                    <h3 class="plan-name">Enterprise</h3>
                    <p class="plan-description">Comprehensive solution for large-scale urban initiatives</p>
                    <div class="plan-price">Custom</div>
                    <span class="plan-period">tailored to your needs</span>
                    <ul class="plan-features">
                        <li>Unlimited participants</li>
                        <li>Unlimited project areas</li>
                        <li>Full platform customization</li>
                        <li>API access</li>
                        <li>Advanced analytics & AI insights</li>
                        <li>Dedicated account manager</li>
                        <li>On-site training</li>
                        <li>Flexible active period</li>
                        <li>Multi-language support</li>
                        <li>Custom integrations</li>
                        <li>SLA guarantee</li>
                    </ul>
                    <a href="/contact" class="btn btn-secondary plan-cta">Contact Sales</a>
                </div>
            </div>

            <div style="text-align: center; margin-top: 4rem;">
                <p style="color: var(--text-medium); font-size: 1.05rem; margin-bottom: 1rem;">All plans include secure hosting, GDPR compliance, and basic analytics</p>
                <p style="color: var(--text-light); font-size: 0.95rem;">Need something different? <a href="/contact" style="color: var(--primary-color); text-decoration: none; font-weight: 500;">Let's talk about a custom solution</a></p>
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h2>Not Sure Which Plan Is Right?</h2>
            <p>Schedule a free consultation to discuss your project needs and find the perfect fit.</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-outline btn-large">Book a Consultation</a>
            </div>
        </div>
    </section>

</Layout>