---
import Layout from '../layouts/Layout.astro';
import directus, { readItems } from '../lib/directus.ts';

const projects = await directus.request(
  readItems('projects', {
    filter: { published: { _eq: true } },
    sort: ['-date'],
  })
);
---

<Layout title="Projects - City Layers">

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">Our Projects</h1>
            <p class="page-subtitle">Real communities, real participation, real impact</p>
        </div>
    </section>

    <section style="padding: 100px 2rem;">
        <div class="container">
            <div class="projects-grid">
                {projects.map((project) => (
                    <div class="project-card">
                        <div class="project-image">
                            {project.cover_image ? (
                                <img
                                    src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${project.cover_image}`}
                                    alt={project.project_name}
                                    style="width: 100%; height: 100%; object-fit: cover;"
                                />
                            ) : (
                                <div class="placeholder-text">Project Image</div>
                            )}
                        </div>
                        <div class="project-content">
                            <div class="project-meta">
                                <span class="project-tag">{project.project_name}</span>
                            </div>
                            <h3 class="project-title">{project.project_name}</h3>
                            <p class="project-description">{project.summary}</p>
                            <a href={`/projects/${project.slug}`} class="btn btn-secondary">View Project →</a>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="cta-section">
        <div class="container">
            <h2>Start Your Own Project</h2>
            <p>Ready to engage your community in meaningful urban participation?</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-outline btn-large">Get Started</a>
            </div>
        </div>
    </section>

</Layout>