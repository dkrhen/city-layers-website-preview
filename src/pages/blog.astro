---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Blog & Resources - City Layers">

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">Blog & Resources</h1>
            <p class="page-subtitle">Insights, research, and knowledge sharing on urban participation</p>
        </div>
    </section>

    <section style="padding: 100px 2rem;">
        <div class="container">
            <div class="blog-grid">
                <div class="blog-main">
                    <article class="blog-article">
                        <div class="article-image">
                            <div class="placeholder-text">Article Featured Image</div>
                        </div>
                        <div class="article-content">
                            <div class="article-meta">
                                <span>📅 February 5, 2024</span>
                                <span>📝 White Paper</span>
                                <span>⏱️ 12 min read</span>
                            </div>
                            <h2 class="article-title">
                                <a href="#">The Future of Digital Urban Participation: Trends and Opportunities</a>
                            </h2>
                            <p class="article-excerpt">
                                Exploring how digital tools are transforming citizen engagement in urban planning, with case studies from European cities and analysis of emerging participation models.
                            </p>
                            <a href="#" class="read-more">Read Full Paper →</a>
                        </div>
                    </article>

                    <article class="blog-article">
                        <div class="article-image">
                            <div class="placeholder-text">Article Featured Image</div>
                        </div>
                        <div class="article-content">
                            <div class="article-meta">
                                <span>📅 January 28, 2024</span>
                                <span>📝 Research</span>
                                <span>⏱️ 8 min read</span>
                            </div>
                            <h2 class="article-title">
                                <a href="#">Inclusive Design in Urban Participation Platforms</a>
                            </h2>
                            <p class="article-excerpt">
                                How to ensure digital participation tools are accessible to all community members, including those with limited digital literacy or disabilities.
                            </p>
                            <a href="#" class="read-more">Read More →</a>
                        </div>
                    </article>

                    <article class="blog-article">
                        <div class="article-image">
                            <div class="placeholder-text">Article Featured Image</div>
                        </div>
                        <div class="article-content">
                            <div class="article-meta">
                                <span>📅 January 15, 2024</span>
                                <span>📝 Case Study</span>
                                <span>⏱️ 10 min read</span>
                            </div>
                            <h2 class="article-title">
                                <a href="#">Vienna's Downtown Revitalization: A Participation Success Story</a>
                            </h2>
                            <p class="article-excerpt">
                                Deep dive into how City Layers facilitated meaningful community input for Vienna's city center transformation, resulting in actionable insights and broad public support.
                            </p>
                            <a href="#" class="read-more">Read Case Study →</a>
                        </div>
                    </article>
                </div>

                <aside class="blog-sidebar">
                    <div class="sidebar-widget">
                        <h3 class="widget-title">Key Terms Glossary</h3>
                        <ul class="glossary-list">
                            <li>
                                <span class="glossary-term">Participatory Planning</span>
                                <p class="glossary-definition">An urban planning approach that actively involves all stakeholders in the strategy and decision-making processes.</p>
                            </li>
                            <li>
                                <span class="glossary-term">Digital Engagement</span>
                                <p class="glossary-definition">Use of digital tools and platforms to facilitate public participation in civic and planning processes.</p>
                            </li>
                            <li>
                                <span class="glossary-term">Spatial Analysis</span>
                                <p class="glossary-definition">Examination of geographic data to identify patterns, relationships, and trends in urban environments.</p>
                            </li>
                            <li>
                                <span class="glossary-term">Co-creation</span>
                                <p class="glossary-definition">Collaborative process where stakeholders jointly develop solutions to urban challenges.</p>
                            </li>
                            <li>
                                <span class="glossary-term">Placemaking</span>
                                <p class="glossary-definition">Community-driven approach to designing public spaces that promote people's health, happiness, and wellbeing.</p>
                            </li>
                        </ul>
                    </div>

                    <div class="sidebar-widget">
                        <h3 class="widget-title">Categories</h3>
                        <ul class="category-list">
                            <li><a href="#">White Papers <span class="category-count">8</span></a></li>
                            <li><a href="#">Case Studies <span class="category-count">12</span></a></li>
                            <li><a href="#">Research <span class="category-count">15</span></a></li>
                            <li><a href="#">Guides <span class="category-count">6</span></a></li>
                            <li><a href="#">News <span class="category-count">23</span></a></li>
                        </ul>
                    </div>

                    <div class="sidebar-widget">
                        <h3 class="widget-title">Newsletter</h3>
                        <p style="margin-bottom: 1rem; color: var(--text-medium); font-size: 0.95rem;">Get the latest insights on urban participation delivered to your inbox.</p>
                        <form class="newsletter-form" style="flex-direction: column;">
                            <input type="email" placeholder="Your email" class="newsletter-input" style="border: 2px solid var(--gray-200); color: var(--text-dark);">
                            <button type="submit" class="newsletter-btn" style="width: 100%; background: var(--primary-color);">Subscribe</button>
                        </form>
                    </div>
                </aside>
            </div>
        </div>
    </section>

</Layout>