---
import Layout from '../layouts/Layout.astro';
import directus, { readItems } from '../lib/directus.ts';

const posts = await directus.request(
  readItems('blog_posts', {
    filter: { published: { _eq: true } },
    sort: ['-publish_date'],
    fields: [
      'title',
      'slug',
      'excerpt',
      'publish_date',
      'cover_image',
      'author.full_name',
      'author.photo',
    ],
  })
);
---

<Layout title="Blog & Resources - City Layers">

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">Blog & Resources</h1>
            <p class="page-subtitle">Insights, research, and knowledge sharing on urban participation</p>
        </div>
    </section>

    <section style="padding: 100px 2rem;">
        <div class="container">
            <div class="blog-grid">
                <div class="blog-main">
                    {posts.map((post) => (
                        <article class="blog-article">
                            <div class="article-image">
                                {post.cover_image ? (
                                    <img
                                        src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${post.cover_image}`}
                                        alt={post.title}
                                        style="width: 100%; height: 100%; object-fit: cover;"
                                    />
                                ) : (
                                    <div class="placeholder-text">Article Featured Image</div>
                                )}
                            </div>
                            <div class="article-content">
                                <div class="article-meta">
                                    <span>📅 {new Date(post.publish_date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                                    {post.author && <span>✍️ {post.author.full_name}</span>}
                                </div>
                                <h2 class="article-title">
                                    <a href={`/blog/${post.slug}`}>{post.title}</a>
                                </h2>
                                <p class="article-excerpt">{post.excerpt}</p>
                                <a href={`/blog/${post.slug}`} class="read-more">Read More →</a>
                            </div>
                        </article>
                    ))}
                </div>

                <aside class="blog-sidebar">
                    <div class="sidebar-widget">
                        <h3 class="widget-title">Categories</h3>
                        <ul class="category-list">
                            <li><a href="#">White Papers</a></li>
                            <li><a href="#">Case Studies</a></li>
                            <li><a href="#">Research</a></li>
                            <li><a href="#">Guides</a></li>
                            <li><a href="#">News</a></li>
                        </ul>
                    </div>

                    <div class="sidebar-widget">
                        <h3 class="widget-title">Newsletter</h3>
                        <p style="margin-bottom: 1rem; color: var(--text-medium); font-size: 0.95rem;">Get the latest insights on urban participation delivered to your inbox.</p>
                        <form class="newsletter-form" style="flex-direction: column;">
                            <input type="email" placeholder="Your email" class="newsletter-input" style="border: 2px solid var(--gray-200); color: var(--text-dark);">
                            <button type="submit" class="newsletter-btn" style="width: 100%; background: var(--primary-color);">Subscribe</button>
                        </form>
                    </div>
                </aside>
            </div>
        </div>
    </section>

</Layout>