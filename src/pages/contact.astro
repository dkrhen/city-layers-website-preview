---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us - City Layers">

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">Get in Touch</h1>
            <p class="page-subtitle">Let's discuss how City Layers can help your community</p>
        </div>
    </section>

    <section class="contact-section">
        <div class="contact-container">
            <div class="contact-info">
                <h2>We'd Love to Hear From You</h2>
                <p>Whether you're planning a community project, need a demo, or just have questions about urban participation, our team is here to help.</p>

                <div class="contact-details">
                    <div class="contact-item">
                        <div class="contact-icon">📧</div>
                        <div class="contact-item-content">
                            <h3>Email</h3>
                            <p><a href="mailto:hello@citylayer.eu">hello@citylayer.eu</a></p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">📍</div>
                        <div class="contact-item-content">
                            <h3>Office</h3>
                            <p>Vienna, Austria<br>European Union</p>
                        </div>
                    </div>
                    <div class="contact-item">
                        <div class="contact-icon">🌐</div>
                        <div class="contact-item-content">
                            <h3>Social Media</h3>
                            <p>Follow us on <a href="#">LinkedIn</a>, <a href="#">Twitter</a>, and <a href="#">Instagram</a></p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form-container">
                <form class="contact-form" id="contactForm">
                    <div class="form-group">
                        <label for="name">Name *</label>
                        <input type="text" id="name" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email *</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="organization">Organization</label>
                        <input type="text" id="organization" name="organization">
                    </div>
                    <div class="form-group">
                        <label for="interest">I'm interested in *</label>
                        <select id="interest" name="interest" required>
                            <option value="">Select an option</option>
                            <option value="demo">Request a Demo</option>
                            <option value="project">Start a Project</option>
                            <option value="pricing">Pricing Information</option>
                            <option value="partnership">Partnership Opportunities</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="message">Message *</label>
                        <textarea id="message" name="message" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary form-submit">Send Message</button>
                </form>
            </div>
        </div>
    </section>

</Layout>