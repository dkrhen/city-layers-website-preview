---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Capabilities - City Layers">

    <section class="page-hero">
        <div class="container">
            <h1 class="page-title">Our Approach</h1>
            <p class="page-subtitle">Cutting-edge tools that transform how communities participate in urban planning</p>
        </div>
    </section>

    <!-- Capabilities Intro -->
    <section style="padding: 80px 2rem 40px;">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Built for the Cities of Tomorrow</h2>
                <p class="section-description">City Layers combines artificial intelligence, real-time data, and intuitive design to make urban participation more meaningful, accessible, and impactful than ever before.</p>
            </div>
        </div>
    </section>

    <!-- Capabilities Grid -->
    <section style="padding: 40px 2rem 80px;">
        <div class="container">
            <div class="features-grid">

                <div class="feature-card">
                    <div class="feature-number">01</div>
                    <h3>Interactive Mapping</h3>
                    <p>Visualise ideas and community feedback directly on dynamic maps. Citizens can pin locations, draw zones, and annotate areas of interest — making spatial planning intuitive for everyone regardless of technical background.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">02</div>
                    <h3>Intelligent Dashboards</h3>
                    <p>AI-powered dashboards that automatically surface the most important insights from your community data. Track participation trends, sentiment analysis, and emerging themes — all updated in real time as new responses come in.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">03</div>
                    <h3>Natural Language Querying</h3>
                    <p>Ask questions about your data in plain language and get instant answers. No SQL, no technical expertise required. Simply type "What are the most requested improvements in the eastern district?" and get a clear, actionable response.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">04</div>
                    <h3>Community Engagement Tools</h3>
                    <p>A full suite of participation tools including surveys, polls, idea boards, and discussion forums. Designed to be accessible to all community members — including those with limited digital literacy or accessibility needs.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">05</div>
                    <h3>Data Analytics & Reporting</h3>
                    <p>Transform raw community input into comprehensive, presentation-ready reports. Export data in multiple formats, generate heat maps, and create stakeholder presentations with a single click.</p>
                </div>

                <div class="feature-card">
                    <div class="feature-number">06</div>
                    <h3>Real-time Collaboration</h3>
                    <p>Multiple planners and stakeholders can work simultaneously on the same project. Live updates, shared annotations, and instant notifications ensure your entire team stays aligned throughout the planning process.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- How It Comes Together -->
    <section style="padding: 80px 2rem; background: var(--gray-50, #f9f9f9);">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title text-center">How It All Comes Together</h2>
                <p class="section-description text-center">From project launch to final report — City Layers handles every step of the participation process</p>
            </div>
            <div class="features-grid" style="margin-top: 3rem;">
                <div class="feature-card">
                    <div class="feature-number">→</div>
                    <h3>Launch Your Project</h3>
                    <p>Define your planning area, set participation goals, and configure your engagement tools in minutes — no technical setup required.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-number">→</div>
                    <h3>Engage Your Community</h3>
                    <p>Share your project via link, QR code, or embed it directly on your website. Reach residents where they are — on any device, in any language.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-number">→</div>
                    <h3>Analyse & Act</h3>
                    <p>Our AI surfaces the key themes, priorities, and spatial patterns from your data — giving decision-makers clear, evidence-based insights to act on.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
        <div class="container">
            <h2>Ready to See It in Action?</h2>
            <p>Book a personalised demo and discover how City Layers can transform participation for your community.</p>
            <div class="cta-buttons">
                <a href="/contact" class="btn btn-primary btn-large">Get in Touch</a>
                <a href="/projects" class="btn btn-outline btn-large">View Our Projects</a>
            </div>
        </div>
    </section>

</Layout>